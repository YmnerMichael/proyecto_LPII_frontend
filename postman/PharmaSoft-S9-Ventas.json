{
  "info": {
    "name": "PharmaSoft - S9 Ventas",
    "description": "Peticiones manuales para registrar ventas y consultar el reporte de ventas por categoría. Completa los IDs y fechas de las variables antes de ejecutar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ventas",
      "item": [
        {
          "name": "Registrar venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"detalles\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Registrar venta con producto repetido (V-05)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"detalles\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 1 },\n    { \"productoId\": {{productoId}}, \"cantidad\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Registrar venta para cliente inactivo (M-02)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteInactivoId}},\n  \"detalles\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar venta por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ventas/{{ventaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas",
                "{{ventaId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Buscar ventas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ventas/buscar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas",
                "buscar"
              ],
              "query": [
                {
                  "key": "clienteId",
                  "value": "{{clienteId}}",
                  "disabled": true
                },
                {
                  "key": "estado",
                  "value": "REGISTRADA",
                  "disabled": true
                },
                {
                  "key": "desde",
                  "value": "{{desde}}",
                  "disabled": true
                },
                {
                  "key": "hasta",
                  "value": "{{hasta}}",
                  "disabled": true
                },
                {
                  "key": "pagina",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "tamanio",
                  "value": "10",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Ventas por categoría (histórico)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reportes/ventas-por-categoria",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "ventas-por-categoria"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Ventas por categoría (rango de fechas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reportes/ventas-por-categoria?desde={{desde}}&hasta={{hasta}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reportes",
                "ventas-por-categoria"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "{{desde}}"
                },
                {
                  "key": "hasta",
                  "value": "{{hasta}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "clienteInactivoId",
      "value": "2"
    },
    {
      "key": "productoId",
      "value": "1"
    },
    {
      "key": "ventaId",
      "value": "1"
    },
    {
      "key": "desde",
      "value": "2026-10-01"
    },
    {
      "key": "hasta",
      "value": "2026-10-14"
    }
  ]
}
